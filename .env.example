# Copy to .env and adjust. Every value is optional; defaults are shown.

# --- Storage --------------------------------------------------------------
# RAG_DATA_DIR=./data
# RAG_OUTPUTS_DIR=./outputs
# RAG_MAX_UPLOAD_MB=20

# --- Chunking & retrieval -------------------------------------------------
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_RETRIEVAL_STRATEGY=hybrid        # dense | keyword | hybrid | rrf
# RAG_TOP_K=5
# RAG_HYBRID_ALPHA=0.6
# RAG_MIN_RELEVANCE=                    # empty = model default (0.35 MiniLM, 0.60 BGE-small)
# RAG_DEVICE=auto                       # auto | cpu | cuda

# --- Generation -----------------------------------------------------------
# RAG_LLM_PROVIDER=ollama               # ollama | openai_compatible | none
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:latest
# RAG_LLM_TIMEOUT_S=180
# RAG_TEMPERATURE=0.1
# RAG_MAX_ANSWER_TOKENS=512
# RAG_PROMPT_VARIANT=strict             # strict | baseline

# --- Optional OpenAI-compatible API (OpenAI, BytePlus ModelArk, vLLM, ...) --
# Example for BytePlus ModelArk:
#   OPENAI_COMPATIBLE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
#   OPENAI_COMPATIBLE_MODEL=<your model or endpoint id>
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
# OPENAI_COMPATIBLE_API_KEY=

# Cost estimates are shown only when both prices are set (currency per 1K tokens).
# RAG_PRICE_PER_1K_INPUT=
# RAG_PRICE_PER_1K_OUTPUT=
